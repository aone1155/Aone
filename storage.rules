rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function admin() {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin'
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.status == 'active';
    }
    function validImage(maxBytes) {
      return request.resource != null
        && request.resource.size > 0
        && request.resource.size <= maxBytes
        && request.resource.contentType.matches('image/(jpeg|jpg|png|webp|gif)');
    }
    match /products/{productId}/{fileName} {
      allow read: if true;
      allow create, update: if admin() && validImage(5 * 1024 * 1024);
      allow delete: if admin();
    }
    match /banners/{bannerId}/{fileName} {
      allow read: if true;
      allow create, update: if admin() && validImage(5 * 1024 * 1024);
      allow delete: if admin();
    }
    match /avatars/{uid}/{fileName} {
      allow read: if true;
      allow create, update: if request.auth != null && request.auth.uid == uid && validImage(2 * 1024 * 1024);
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
    match /{allPaths=**} { allow read, write: if false; }
  }
}
